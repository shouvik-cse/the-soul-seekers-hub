{
  "name": "the-the-soul-seekers-hub",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:create": "wrangler d1 create the-soul-seekers-hub",
    "db:migrate:local": "wrangler d1 migrations apply the-soul-seekers-hub --local",
    "db:migrate:remote": "wrangler d1 migrations apply the-soul-seekers-hub --remote",
    "db:seed:local": "python scripts/import_catalogue.py local.sqlite"
  },
  "devDependencies": {
    "wrangler": "^4.0.0",
    "typescript": "^5.7.0"
  }
}